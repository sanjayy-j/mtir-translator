func @deep(i32 %n) -> i32 {
entry:
  %t0 = icmp.sgt i32 %n, 0
  br %t0 ? if.then.0 : if.end.0
if.then.0:
  %t1 = icmp.sgt i32 %n, 1
  br %t1 ? if.then.1 : if.end.1
if.then.1:
  %t2 = icmp.sgt i32 %n, 2
  br %t2 ? if.then.2 : if.end.2
if.then.2:
  %t3 = icmp.sgt i32 %n, 3
  br %t3 ? if.then.3 : if.end.3
if.then.3:
  %t4 = icmp.sgt i32 %n, 4
  br %t4 ? if.then.4 : if.end.4
if.then.4:
  ret i32 5
if.end.4:
  ret i32 4
if.end.3:
  ret i32 3
if.end.2:
  ret i32 2
if.end.1:
  ret i32 1
if.end.0:
  ret i32 0
}
func @empty() -> void {
entry:
  ret void
}
func @main() -> i32 {
entry:
  %i.addr = alloca i32
  br while.head.0
while.head.0:
  br 0 ? while.body.0 : while.end.0
while.body.0:
  br while.head.0
while.end.0:
  store i32 0, %i.addr
  br for.head.1
for.head.1:
  %t0 = load i32 %i.addr
  %t1 = icmp.slt i32 %t0, 0
  br %t1 ? for.body.1 : for.end.1
for.body.1:
  br for.step.1
for.step.1:
  %t2 = load i32 %i.addr
  %t3 = add i32 %t2, 1
  store i32 %t3, %i.addr
  br for.head.1
for.end.1:
  call void @empty()
  %t4 = call i32 @deep(3)
  print.i32 %t4
  ret i32 0
}
