func @fact(i32 %n) -> i32 {
entry:
  %t0 = icmp.sle i32 %n, 1
  br %t0 ? if.then.0 : if.end.0
if.then.0:
  ret i32 1
if.end.0:
  %t1 = sub i32 %n, 1
  %t2 = call i32 @fact(%t1)
  %t3 = mul i32 %n, %t2
  ret i32 %t3
}
func @is_even(i32 %n) -> i1 {
entry:
  %t0 = icmp.eq i32 %n, 0
  br %t0 ? if.then.0 : if.end.0
if.then.0:
  ret i1 1
if.end.0:
  %t1 = sub i32 %n, 1
  %t2 = call i1 @is_odd(%t1)
  ret i1 %t2
}
func @is_odd(i32 %n) -> i1 {
entry:
  %t0 = icmp.eq i32 %n, 0
  br %t0 ? if.then.0 : if.end.0
if.then.0:
  ret i1 0
if.end.0:
  %t1 = sub i32 %n, 1
  %t2 = call i1 @is_even(%t1)
  ret i1 %t2
}
func @main() -> i32 {
entry:
  %t0 = call i32 @fact(10)
  print.i32 %t0
  %t1 = call i1 @is_even(4)
  br %t1 ? if.then.0 : if.end.0
if.then.0:
  print.i32 1
  br if.end.0
if.end.0:
  ret i32 0
}
