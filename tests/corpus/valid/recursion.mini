// Recursion and mutual recursion.
fn fact(n: int) -> int {
    if (n <= 1) { return 1; }
    return n * fact(n - 1);
}

fn is_even(n: int) -> bool {
    if (n == 0) { return true; }
    return is_odd(n - 1);
}

fn is_odd(n: int) -> bool {
    if (n == 0) { return false; }
    return is_even(n - 1);
}

fn main() -> int {
    print_int(fact(10));
    if (is_even(4)) { print_int(1); }
    return 0;
}
