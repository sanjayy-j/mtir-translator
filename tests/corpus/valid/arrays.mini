// Arrays, globals, and float arithmetic.
global counter: int = 0;

fn sum(n: int) -> int {
    let xs: int[8] = 0;
    let i: int = 0;
    while (i < n) {
        xs[i] = i * i;
        i = i + 1;
    }
    let total: int = 0;
    i = 0;
    while (i < n) {
        total = total + xs[i];
        i = i + 1;
    }
    counter = counter + 1;
    return total;
}

fn main() -> int {
    let avg: float = 3.5 * 2.0 + 1.0e2;
    print_float(avg);
    print_int(sum(8));
    return 0;
}
