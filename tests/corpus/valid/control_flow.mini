// if / else-if / while / for / break / continue.
fn classify(n: int) -> int {
    if (n < 0) { return -1; }
    else if (n == 0) { return 0; }
    else { return 1; }
}

fn main() -> int {
    let total: int = 0;
    let i: int = 0;
    while (i < 10) {
        if (i % 2 == 0) { i = i + 1; continue; }
        if (i > 7) { break; }
        total = total + i;
        i = i + 1;
    }
    for (let j: int = 0; j < 3; j = j + 1) {
        total = total + classify(j - 1);
    }
    print_int(total);
    return 0;
}
