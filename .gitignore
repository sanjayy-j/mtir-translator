# C++ build artefacts
build/
cmake-build-*/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.exe
*.pdb
*.ilk
CMakeCache.txt
CMakeFiles/
compile_commands.json
Testing/
.cache/

# Python reference implementation (removed with the prototype)
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# Generated compiler output
*.ll
*.bc
*.wat
*.wasm
*.sbc
out/

# Keep the hand-written worked examples, which are checked-in evidence
!docs/examples/*.ll
!docs/examples/*.wat

.DS_Store
.idea/
.vscode/

# Demo output.  The runner regenerates everything under demo/out/ on each
# run; demo/expected/ holds the checked-in reference copies.
demo/out/
!demo/expected/*.ll
!demo/expected/*.wat
